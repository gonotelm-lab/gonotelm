# ==============================================================================
# gonotelm 环境变量示例 / gonotelm environment variables example
# ------------------------------------------------------------------------------
# 用法 / Usage:
#   cp .env.example .env
#   编辑 .env，然后按需运行 / edit .env, then run:
#     make run-notelm | make run-worker | make run-sourcejob
#
# 说明 / Notes:
#   - 所有变量均为可选，未设置时使用 etc/*.toml.tpl 中的默认值。
#     All variables are optional; unset ones fall back to defaults in etc/*.toml.tpl.
#   - 敏感信息（密钥、密码）留空，请勿提交到版本库。
#     Secrets (keys, passwords) are left empty; never commit them to VCS.
#   - 值为数组/含特殊字符时需加引号 / quote values containing arrays or special chars.
# ==============================================================================

# ==============================================================================
# 1. 通用 / General
# ==============================================================================

# 日志级别 / Log level (debug, info, warn, error)
GONOTELM_LOG_LEVEL=debug

# OpenTelemetry 链路追踪上报地址 / OpenTelemetry trace exporter endpoint
OTEL_TRACE_ENDPOINT=127.0.0.1:4317

# API 退出等待超时 / API graceful-shutdown wait timeout
GONOTELM_API_EXIT_WAIT_TIMEOUT=30s


# ==============================================================================
# 2. PostgreSQL（主业务库）/ PostgreSQL (primary database)
# ==============================================================================

# 主机地址 / Host
GONOTELM_DB_HOST=127.0.0.1
# 端口 / Port
GONOTELM_DB_PORT=5432
# 用户名 / User
GONOTELM_DB_USER=postgres
# 密码 / Password
GONOTELM_DB_PASSWORD=
# 数据库名 / Database name
GONOTELM_DB_NAME=gonotelm


# ==============================================================================
# 3. ClickHouse（OLAP 分析库）/ ClickHouse (OLAP database)
# ==============================================================================

# 主机地址 / Host
GONOTELM_OLAP_DB_HOST=127.0.0.1
# 端口 / Port
GONOTELM_OLAP_DB_PORT=9000
# 用户名 / User
GONOTELM_OLAP_DB_USER=clickhouse
# 密码 / Password
GONOTELM_OLAP_DB_PASSWORD=
# 数据库名 / Database name
GONOTELM_OLAP_DB_NAME=gonotelm


# ==============================================================================
# 4. Redis（缓存）/ Redis (cache)
# ==============================================================================

# 节点地址列表，TOML 数组格式 / Address list in TOML array format
GONOTELM_REDIS_ADDRS="['127.0.0.1:7542']"
# 用户名（可选）/ Username (optional)
GONOTELM_REDIS_USERNAME=
# 密码（可选）/ Password (optional)
GONOTELM_REDIS_PASSWORD=


# ==============================================================================
# 5. Milvus（向量数据库）/ Milvus (vector database)
# ==============================================================================

# 服务地址 / Server address
GONOTELM_MILVUS_ADDR=127.0.0.1:19530
# 用户名（可选）/ Username (optional)
GONOTELM_MILVUS_USERNAME=
# 密码（可选）/ Password (optional)
GONOTELM_MILVUS_PASSWORD=
# 数据库名 / Database name
GONOTELM_MILVUS_DB_NAME=gonotelm
# 连接超时 / Dial timeout
GONOTELM_MILVUS_DIAL_TIMEOUT=10s


# ==============================================================================
# 6. MinIO（对象存储）/ MinIO (object storage)
# ==============================================================================

# 服务端点 host:port / Endpoint host:port
GONOTELM_MINIO_ENDPOINT=127.0.0.1:9000
# Access Key
GONOTELM_MINIO_ACCESS_KEY=
# Secret Key
GONOTELM_MINIO_SECRET_KEY=
# 区域 / Region
GONOTELM_MINIO_REGION=us-east-1
# 是否启用 TLS / Whether to use TLS
GONOTELM_MINIO_SECURE=false
# 预签名 URL 有效期 / Presigned URL expiry
GONOTELM_MINIO_PRESIGN_EXPIRY=15m


# ==============================================================================
# 7. Kafka（消息队列）/ Kafka (message queue)
# ==============================================================================

# Broker 地址 / Broker address
GONOTELM_KAFKA_BROKER=127.0.0.1:9094
# 用户名 / Username
GONOTELM_KAFKA_USERNAME=kafka
# 密码 / Password
GONOTELM_KAFKA_PASSWORD=
# 消费端队列容量 / Consumer queue capacity
GONOTELM_KAFKA_CONSUMER_QUEUE_CAPACITY=100
# 消费位点提交间隔，0s 表示自动 / Consumer commit interval, 0s means auto
GONOTELM_KAFKA_CONSUMER_COMMIT_INTERVAL=0s


# ==============================================================================
# 8. Flow（工作流引擎）/ Flow (workflow engine)
# ==============================================================================

# 服务地址 / Server address
GONOTELM_FLOW_ADDR=localhost:7091
# 命名空间 / Namespace
GONOTELM_FLOW_NAMESPACE=gonotelm
# 最大重试次数 / Max retry count
GONOTELM_FLOW_MAX_RETRY=3
# 连接超时 / Dial timeout
GONOTELM_FLOW_DIAL_TIMEOUT=5s


# ==============================================================================
# 9. Chat 对话（notelm）/ Chat (notelm)
# ==============================================================================

# 模型提供方 / Model provider (deepseek, openai, qwen, agnes)
GONOTELM_CHAT_PROVIDER=qwen
# 对话模型 / Chat model
GONOTELM_CHAT_MODEL=glm-5.1
# 最大对话轮数 / Max chat rounds
GONOTELM_CHAT_MAX_ROUND=30
# 是否启用重排序 / Enable rerank
GONOTELM_CHAT_RERANK_ENABLED=false
# 重排序提供方 / Rerank provider
GONOTELM_RERANK_PROVIDER=qwen
# 重排序保留条数 / Rerank top N
GONOTELM_CHAT_RERANK_TOP_N=30
# 重排序模型 / Rerank model
GONOTELM_CHAT_RERANK_MODEL=qwen3-rerank


# ==============================================================================
# 10. Source 来源处理 / Source processing
#     （notelm 与 sourcejob 共用；注意两者模板默认值不同）
#     (shared by notelm and sourcejob; note their template defaults differ)
# ==============================================================================

# 文本模型提供方 / Text model provider
#   notelm 默认 qwen / sourcejob 默认 deepseek
#   notelm defaults to qwen / sourcejob defaults to deepseek
GONOTELM_SOURCE_PROVIDER=deepseek
# 文本模型 / Text model
GONOTELM_SOURCE_MODEL=deepseek-flash
# 图片理解模型提供方（仅 sourcejob）/ Image understanding provider (sourcejob only)
GONOTELM_SOURCE_IMAGE_MODEL_PROVIDER=deepseek
# 图片理解模型（仅 sourcejob）/ Image understanding model (sourcejob only)
GONOTELM_SOURCE_IMAGE_MODEL=deepseek-flash
# URL 黑名单正则，留空则禁用 / URL blacklist regex; leave empty to disable
# GONOTELM_SOURCE_URL_BLACKLIST_REGEX="(127\\.0\\.0\\.1|localhost)"
# 来源业务缓存淘汰时间 / Source biz-cache eviction
GONOTELM_SOURCE_BIZCACHE_EVICTION=15m
# 来源业务缓存最大容量(MB) / Source biz-cache max size (MB)
GONOTELM_SOURCE_BIZCACHE_MAX_MB=1024


# ==============================================================================
# 11. Chunking 文本切分 / Text chunking
# ==============================================================================

# 分块大小 / Chunk size
GONOTELM_CHUNKING_SIZE=500
# 分块重叠大小 / Chunk overlap size
GONOTELM_CHUNKING_OVERLAP_SIZE=75


# ==============================================================================
# 12. Syncer 同步器 / Syncer
# ==============================================================================

# 单任务同步间隔 / Per-task sync interval
GONOTELM_SYNCER_PER_TASK_INTERVAL=2s
# 全局同步间隔 / Global sync interval
GONOTELM_SYNCER_GLOBAL_INTERVAL=5s
# 全局批量大小 / Global batch size
GONOTELM_SYNCER_GLOBAL_BATCH_SIZE=100


# ==============================================================================
# 13. Embedding 向量化 / Embedding
# ==============================================================================

# 向量化类型 / Embedding type (qwen, openai, ark, gemini, ollama, qianfan, tencentcloud, openai)
GONOTELM_EMBEDDING_TYPE=qwen
# 批大小 / Batch size
GONOTELM_EMBEDDING_BATCH_SIZE=10
# 最大并发 / Max concurrency
GONOTELM_EMBEDDING_MAX_CONCURRENCY=4

# --- Qwen 向量化 / Qwen embedding ---
# 向量模型 / Embedding model
GONOTELM_QWEN_EMBEDDING_MODEL=text-embedding-v4
# 请求超时 / Request timeout
GONOTELM_QWEN_EMBEDDING_TIMEOUT=30s
# 向量维度 / Vector dimensions
GONOTELM_QWEN_EMBEDDING_DIMENSIONS=1024

# --- OpenAI 向量化 / OpenAI embedding ---
# 模型与超时复用下方的 GONOTELM_OPENAI_MODEL / GONOTELM_OPENAI_TIMEOUT
# Model and timeout reuse GONOTELM_OPENAI_MODEL / GONOTELM_OPENAI_TIMEOUT below
# 编码格式 / Encoding format
GONOTELM_OPENAI_ENCODING_FORMAT=float
# 向量维度 / Vector dimensions
GONOTELM_OPENAI_DIMENSIONS=1024
# 请求用户标识（可选）/ Request user identifier (optional)
GONOTELM_OPENAI_USER=
# 是否使用 Azure / Whether to use Azure
GONOTELM_OPENAI_BY_AZURE=false
# Azure API 版本（可选）/ Azure API version (optional)
GONOTELM_OPENAI_API_VERSION=

# --- Ark 向量化 / Ark embedding ---
# 鉴权信息 / Credentials
GONOTELM_ARK_API_KEY=
GONOTELM_ARK_ACCESS_KEY=
GONOTELM_ARK_SECRET_KEY=
# 服务地址 / Base URL
GONOTELM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 区域 / Region
GONOTELM_ARK_REGION=cn-beijing
# 模型 / Model
GONOTELM_ARK_MODEL=
# 接口类型 / API type
GONOTELM_ARK_API_TYPE=text_api
# 请求超时 / Request timeout
GONOTELM_ARK_TIMEOUT=10m
# 重试次数 / Retry times
GONOTELM_ARK_RETRY_TIMES=2
# 最大并发请求数 / Max concurrent requests
GONOTELM_ARK_MAX_CONCURRENT_REQUESTS=5

# --- Gemini 向量化 / Gemini embedding ---
GONOTELM_GEMINI_API_KEY=
# 后端类型 / Backend type
GONOTELM_GEMINI_BACKEND=gemini_api
# 项目与区域 / Project and location
GONOTELM_GEMINI_PROJECT=
GONOTELM_GEMINI_LOCATION=
# 模型 / Model
GONOTELM_GEMINI_MODEL=gemini-embedding-001
# 任务类型 / Task type
GONOTELM_GEMINI_TASK_TYPE=RETRIEVAL_DOCUMENT
# 标题（可选）/ Title (optional)
GONOTELM_GEMINI_TITLE=
# 输出维度 / Output dimensionality
GONOTELM_GEMINI_EMBED_DIMENSIONS=1024
# MIME 类型 / MIME type
GONOTELM_GEMINI_MIME_TYPE=text/plain
# 是否自动截断 / Whether to auto truncate
GONOTELM_GEMINI_AUTO_TRUNCATE=true

# --- Ollama 向量化 / Ollama embedding ---
# 服务地址 / Base URL
GONOTELM_OLLAMA_BASE_URL=http://localhost:11434
# 模型 / Model
GONOTELM_OLLAMA_MODEL=bge-m3
# 请求超时 / Request timeout
GONOTELM_OLLAMA_TIMEOUT=30s
# 是否截断 / Whether to truncate
GONOTELM_OLLAMA_TRUNCATE=false
# 模型保活时间 / Model keep-alive
GONOTELM_OLLAMA_KEEP_ALIVE=5m

# --- 百度千帆向量化 / Baidu Qianfan embedding ---
# 鉴权信息 / Credentials
GONOTELM_QIANFAN_AK=
GONOTELM_QIANFAN_SK=
GONOTELM_QIANFAN_ACCESS_KEY=
GONOTELM_QIANFAN_SECRET_KEY=
GONOTELM_QIANFAN_ACCESS_TOKEN=
GONOTELM_QIANFAN_BEARER_TOKEN=
# 模型 / Model
GONOTELM_QIANFAN_MODEL=Embedding-V1

# --- 腾讯云向量化 / Tencent Cloud embedding ---
# 鉴权信息 / Credentials
GONOTELM_TENCENTCLOUD_SECRET_ID=
GONOTELM_TENCENTCLOUD_SECRET_KEY=
# 区域 / Region
GONOTELM_TENCENTCLOUD_REGION=ap-guangzhou


# ==============================================================================
# 14. 大模型提供方 / LLM providers
# ==============================================================================

# --- DeepSeek ---
# API 密钥 / API key
GONOTELM_DEEPSEEK_API_KEY=
# 服务地址 / Base URL
GONOTELM_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 默认模型 / Default model
GONOTELM_DEEPSEEK_MODEL=deepseek-flash
# 请求总超时 / Total request timeout
GONOTELM_DEEPSEEK_TIMEOUT=5m
# 响应头超时 / Response header timeout
GONOTELM_DEEPSEEK_RESPONSE_HEADER_TIMEOUT=10s

# --- OpenAI（兼容接口）/ OpenAI (compatible API) ---
# API 密钥 / API key
GONOTELM_OPENAI_API_KEY=
# 服务地址 / Base URL
GONOTELM_OPENAI_BASE_URL=https://api.openai.com/v1
# 默认模型 / Default model
GONOTELM_OPENAI_MODEL=gpt-4o-mini
# 请求总超时 / Total request timeout
GONOTELM_OPENAI_TIMEOUT=5m
# 响应头超时 / Response header timeout
GONOTELM_OPENAI_RESPONSE_HEADER_TIMEOUT=10s
# 采样温度 / Sampling temperature
GONOTELM_OPENAI_TEMPERATURE=1.0
# 推理强度（可选）/ Reasoning effort (optional)
GONOTELM_OPENAI_REASONING_EFFORT=

# --- Qwen / 通义千问 ---
# API 密钥 / API key
GONOTELM_QWEN_API_KEY=
# 服务地址 / Base URL
GONOTELM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认模型 / Default model
GONOTELM_QWEN_MODEL=glm-5.1
# 请求总超时 / Total request timeout
GONOTELM_QWEN_TIMEOUT=5m
# 响应头超时 / Response header timeout
GONOTELM_QWEN_RESPONSE_HEADER_TIMEOUT=10s
# 采样温度 / Sampling temperature
GONOTELM_QWEN_TEMPERATURE=1.0
# 核采样 / Top P
GONOTELM_QWEN_TOP_P=1.0
# 是否开启思考模式 / Enable thinking mode
GONOTELM_QWEN_ENABLE_THINKING=false

# --- Agnes ---
# API 密钥 / API key
GONOTELM_AGNES_API_KEY=
# 服务地址 / Base URL
GONOTELM_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# 默认模型 / Default model
GONOTELM_AGNES_MODEL=agnes-2.5-flash
# 请求总超时 / Total request timeout
GONOTELM_AGNES_TIMEOUT=5m
# 响应头超时 / Response header timeout
GONOTELM_AGNES_RESPONSE_HEADER_TIMEOUT=10s
# 采样温度 / Sampling temperature
GONOTELM_AGNES_TEMPERATURE=1.0
# 核采样 / Top P
GONOTELM_AGNES_TOP_P=1.0


# ==============================================================================
# 15. 重排序 / Rerank（Qwen）
# ==============================================================================

# 服务地址 / Base URL
GONOTELM_RERANK_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# 模型 / Model
GONOTELM_RERANK_QWEN_MODEL=qwen3-rerank
# 请求超时 / Request timeout
GONOTELM_RERANK_QWEN_TIMEOUT=30s


# ==============================================================================
# 16. 文生图 / Text-to-image
# ==============================================================================

# --- Qwen 文生图 / Qwen text-to-image ---
# 服务地址 / Base URL
GONOTELM_TEXT2IMAGE_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 模型 / Model
GONOTELM_TEXT2IMAGE_QWEN_MODEL=qwen-image-2.0-pro
# 请求超时 / Request timeout
GONOTELM_TEXT2IMAGE_QWEN_TIMEOUT=10m

# --- Agnes 文生图 / Agnes text-to-image ---
# 服务地址 / Base URL
GONOTELM_TEXT2IMAGE_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1/images/generations
# 模型 / Model
GONOTELM_TEXT2IMAGE_AGNES_MODEL=agnes-image-2.1-flash
# 请求超时 / Request timeout
GONOTELM_TEXT2IMAGE_AGNES_TIMEOUT=10m


# ==============================================================================
# 17. 文生语音 / Text-to-audio (TTS)
# ==============================================================================

# --- Qwen 语音合成 / Qwen TTS ---
# 服务地址 / Base URL
GONOTELM_TEXT2AUDIO_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# 模型 / Model
GONOTELM_TEXT2AUDIO_QWEN_MODEL=qwen3-tts-flash
# 请求超时 / Request timeout
GONOTELM_TEXT2AUDIO_QWEN_TIMEOUT=10m

# --- MiMo 语音合成 / MiMo TTS ---
# API 密钥 / API key
GONOTELM_MIMO_API_KEY=
# 服务地址 / Base URL
GONOTELM_TEXT2AUDIO_MIMO_BASE_URL=https://api.xiaomimimo.com/v1/chat/completions
# 模型 / Model
GONOTELM_TEXT2AUDIO_MIMO_MODEL=
# 请求超时 / Request timeout
GONOTELM_TEXT2AUDIO_MIMO_TIMEOUT=10m

# --- MiniMax 语音合成 / MiniMax TTS ---
# API 密钥 / API key
GONOTELM_MINIMAX_API_KEY=
# 服务地址 / Base URL
GONOTELM_TEXT2AUDIO_MINIMAX_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
# 模型 / Model
GONOTELM_TEXT2AUDIO_MINIMAX_MODEL=
# 请求超时 / Request timeout
GONOTELM_TEXT2AUDIO_MINIMAX_TIMEOUT=10m


# ==============================================================================
# 18. LLM 调用记录 / LLM call recording
# ==============================================================================

# 是否截断超长的 LLM 输入内容后再落库 / Truncate over-long LLM input before persisting
GONOTELM_LLM_RECORD_TRUNCATE=true


# ==============================================================================
# 19. Sandbox 沙箱 / Sandbox
# ==============================================================================

# 沙箱服务地址 / Sandbox service endpoint
GONOTELM_SANDBOX_ENDPOINT=http://localhost:23080
# 沙箱 API 密钥 / Sandbox API key
GONOTELM_SANDBOX_API_KEY=123456
# 请求超时 / Request timeout
GONOTELM_SANDBOX_TIMEOUT=30s
# 沙箱镜像（按架构区分，构建见 assets/dockerfiles/opensandbox/build.sh）
# Sandbox image (arch-specific, build with assets/dockerfiles/opensandbox/build.sh)
GONOTELM_SANDBOX_IMAGE=ghcr.io/gonotelm-lab/opensandbox-amd64:v0.0.1
# arm64 主机 / arm64 host:
# GONOTELM_SANDBOX_IMAGE=ghcr.io/gonotelm-lab/opensandbox-arm64:v0.0.1


# ==============================================================================
# 20. Worker 工作池 / Worker pool
# ==============================================================================

# 最大并发数 / Max concurrency
GONOTELM_WORKER_MAX_CONCURRENCY=4
# 心跳间隔 / Heartbeat interval
GONOTELM_WORKER_HEARTBEAT=5s
# Agent 是否输出详细日志 / Whether the agent logs verbosely
GONOTELM_WORKER_AGENT_VERBOSE=false


# ==============================================================================
# 21. Studio 生成能力（worker）/ Studio generation (worker)
# ==============================================================================

# --- 思维导图 / Mindmap ---
GONOTELM_STUDIO_MINDMAP_MAX_ROUND=50
GONOTELM_STUDIO_MINDMAP_PROVIDER=deepseek
GONOTELM_STUDIO_MINDMAP_MODEL=deepseek-flash

# --- 报告 / Report ---
GONOTELM_STUDIO_REPORT_MAX_ROUND=50
GONOTELM_STUDIO_REPORT_PROVIDER=deepseek
GONOTELM_STUDIO_REPORT_MODEL=deepseek-flash

# --- 信息图 / Info graphic ---
GONOTELM_STUDIO_INFOGRAPHIC_MAX_ROUND=50
GONOTELM_STUDIO_INFOGRAPHIC_PROVIDER=deepseek
GONOTELM_STUDIO_INFOGRAPHIC_MODEL=deepseek-flash
GONOTELM_STUDIO_INFOGRAPHIC_IMAGE_MODEL_PROVIDER=qwen
GONOTELM_STUDIO_INFOGRAPHIC_IMAGE_MODEL=qwen-image-2.0-pro

# --- 音频概览 / Audio overview ---
GONOTELM_STUDIO_AUDIOOVERVIEW_MAX_ROUND=50
GONOTELM_STUDIO_AUDIOOVERVIEW_PROVIDER=deepseek
GONOTELM_STUDIO_AUDIOOVERVIEW_MODEL=deepseek-flash
GONOTELM_STUDIO_AUDIOOVERVIEW_AUDIO_MODEL_PROVIDER=qwen
GONOTELM_STUDIO_AUDIOOVERVIEW_AUDIO_MODEL=qwen3-tts-instruct-flash
# 语音合成并发数 / TTS concurrency
GONOTELM_STUDIO_AUDIOOVERVIEW_AUDIO_SYNTH_CONCURRENCY=1

# --- 记忆卡片 / Flashcard ---
GONOTELM_STUDIO_FLASHCARD_MAX_ROUND=50
GONOTELM_STUDIO_FLASHCARD_PROVIDER=deepseek
GONOTELM_STUDIO_FLASHCARD_MODEL=deepseek-flash

# --- 测验 / Quiz ---
GONOTELM_STUDIO_QUIZ_MAX_ROUND=50
GONOTELM_STUDIO_QUIZ_PROVIDER=deepseek
GONOTELM_STUDIO_QUIZ_MODEL=deepseek-flash

# --- 数据表 / Data table ---
GONOTELM_STUDIO_DATATABLE_MAX_ROUND=50
GONOTELM_STUDIO_DATATABLE_PROVIDER=deepseek
GONOTELM_STUDIO_DATATABLE_MODEL=deepseek-flash

# --- 幻灯片 / Slides ---
GONOTELM_STUDIO_SLIDES_MAX_ROUND=50
GONOTELM_STUDIO_SLIDES_PROVIDER=deepseek
GONOTELM_STUDIO_SLIDES_GENERATE_MAX_ROUND=100
GONOTELM_STUDIO_SLIDES_MODEL=deepseek-flash
GONOTELM_STUDIO_SLIDES_SANDBOX_PROVIDER=opensandbox

# --- 视频概览 / Video overview ---
GONOTELM_STUDIO_VIDEOOVERVIEW_MAX_ROUND=100
GONOTELM_STUDIO_VIDEOOVERVIEW_PROVIDER=deepseek
GONOTELM_STUDIO_VIDEOOVERVIEW_MODEL=deepseek-flash
GONOTELM_STUDIO_VIDEOOVERVIEW_GENERATE_MAX_ROUND=150
# 子 Agent 并发数与最大轮数 / Sub-agent concurrency and max rounds
GONOTELM_STUDIO_VIDEOOVERVIEW_SUBAGENT_CONCURRENCY=5
GONOTELM_STUDIO_VIDEOOVERVIEW_SUBAGENT_MAX_ROUND=40
GONOTELM_STUDIO_VIDEOOVERVIEW_SANDBOX_PROVIDER=opensandbox
GONOTELM_STUDIO_VIDEOOVERVIEW_AUDIO_MODEL_PROVIDER=qwen
GONOTELM_STUDIO_VIDEOOVERVIEW_AUDIO_MODEL=qwen3-tts-instruct-flash
GONOTELM_STUDIO_VIDEOOVERVIEW_AUDIO_SYNTH_CONCURRENCY=1
# 沙箱资源限制 / Sandbox resource limits
GONOTELM_STUDIO_VIDEOOVERVIEW_SANDBOX_CPU=2
GONOTELM_STUDIO_VIDEOOVERVIEW_SANDBOX_MEMORY=4Gi


# ==============================================================================
# 22. 单元/集成测试 / Unit & integration tests
# ==============================================================================

# --- 测试 PostgreSQL / Test PostgreSQL ---
TEST_GONOTELM_DB_HOST=127.0.0.1
TEST_GONOTELM_DB_PORT=5432
TEST_GONOTELM_DB_USER=postgres
