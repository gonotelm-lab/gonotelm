# deploy/dev 变量清单（参考用，不必复制成 .env）：默认从仓库根目录的 .env 插值，shell 里 export 的优先级更高
# 宿主机 app 也读的变量一律用 GONOTELM_* 原名，一份 .env 同时管住 app 和 compose；DEV_ 前缀的是 compose 专用

# 必需，缺失时 compose 直接报错
GONOTELM_DB_PASSWORD=
GONOTELM_OLAP_DB_PASSWORD=
GONOTELM_MINIO_ACCESS_KEY=
GONOTELM_MINIO_SECRET_KEY=
GONOTELM_KAFKA_PASSWORD=

# 连接参数：改这里等于同时改 app 的连接目标，两边必须一致
GONOTELM_DB_USER=postgres
GONOTELM_DB_PORT=5432

# GONOTELM_OLAP_DB_PORT 是宿主端口（容器内始终 9000）
GONOTELM_OLAP_DB_USER=clickhouse
GONOTELM_OLAP_DB_NAME=gonotelm
GONOTELM_OLAP_DB_PORT=9009
GONOTELM_OLAP_HTTP_PORT=8123

# GONOTELM_REDIS_PORT 必须和 GONOTELM_REDIS_ADDRS 里的端口一致
GONOTELM_REDIS_PORT=7542
GONOTELM_REDIS_PASSWORD=

# bucket 名在 etc/*.toml.tpl 里写死为 gonotelm
# ACCESS_KEY / SECRET_KEY 是 gonotelm 桶自己的凭据（不是 root），minio-init 会拿它建用户并只授权该桶读写
GONOTELM_MINIO_ACCESS_KEY=
GONOTELM_MINIO_PORT=9000
GONOTELM_MINIO_CONSOLE_PORT=9001
GONOTELM_MINIO_REGION=us-east-1
GONOTELM_MINIO_BUCKET=gonotelm
# minio 容器的 root：只在 minio-init 建桶/建桶用户时用，app 不该拿它
GONOTELM_DEV_MINIO_ROOT_USER=minioadmin
GONOTELM_DEV_MINIO_ROOT_PASSWORD=minioadmin

# EXTERNAL 端口必须和 GONOTELM_KAFKA_BROKER 一致
GONOTELM_KAFKA_USERNAME=kafka
GONOTELM_KAFKA_PORT=9092
GONOTELM_KAFKA_EXTERNAL_PORT=9094
GONOTELM_KAFKA_ADVERTISED_HOST=127.0.0.1
GONOTELM_KAFKA_CLUSTER_ID=al6tIt4uS8q1M76IljffhQ   # 22 字符 base64 UUID
GONOTELM_KAFKA_TOPICS=gonotelm.source.preparation

GONOTELM_MILVUS_PORT=19530
GONOTELM_MILVUS_HEALTH_PORT=9091

GONOTELM_FLOW_PORT=7091
GONOTELM_FLOW_HTTP_PORT=7090
GONOTELM_FLOW_WEB_PORT=7089
GONOTELM_FLOW_DB_NAME=flowdb

GONOTELM_OTEL_GRPC_PORT=4317
GONOTELM_OTEL_HTTP_PORT=4318
GONOTELM_JAEGER_UI_PORT=16686

# 数据落盘：默认 compose 具名卷；改成宿主路径即 bind 挂载（etcd 目录属主非 root 时需同时设 ETCD_USER）
# GONOTELM_DEV_PG_DATA=gonotelm_postgres_data_dev
# GONOTELM_DEV_CLICKHOUSE_DATA=gonotelm_clickhouse_data_dev
# GONOTELM_DEV_CLICKHOUSE_LOGS=gonotelm_clickhouse_logs_dev
# GONOTELM_DEV_REDIS_DATA=gonotelm_redis_data_dev
# GONOTELM_DEV_KAFKA_DATA=gonotelm_kafka_data_dev
# GONOTELM_DEV_MINIO_DATA=gonotelm_minio_data_dev
# GONOTELM_DEV_ETCD_DATA=gonotelm_etcd_data_dev
# GONOTELM_DEV_MILVUS_DATA=gonotelm_milvus_data_dev
# GONOTELM_DEV_ETCD_USER=1001:1001
# GONOTELM_DEV_ETCD_NAME=etcd-01

# 镜像（可选）：quay.io/minio/* 已不可拉，干净机器上换 bitnamilegacy/minio + minio/mc
# GONOTELM_DEV_POSTGRES_IMAGE=postgres:18.3
# GONOTELM_DEV_REDIS_IMAGE=redis:7.4
# GONOTELM_DEV_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
# GONOTELM_DEV_KAFKA_IMAGE=bitnami/kafka:latest
# GONOTELM_DEV_MINIO_IMAGE=quay.io/minio/minio:latest
# GONOTELM_DEV_MINIO_MC_IMAGE=quay.io/minio/minio:latest
# GONOTELM_DEV_ETCD_IMAGE=bitnami/etcd:latest
# GONOTELM_DEV_MILVUS_IMAGE=milvusdb/milvus:v2.6.15
# GONOTELM_DEV_FLOW_SERVER_IMAGE=ghcr.io/gonotelm-lab/flow/server:v0.3.0
# GONOTELM_DEV_FLOW_WEB_IMAGE=ghcr.io/gonotelm-lab/flow/web:v0.3.0
# GONOTELM_DEV_JAEGER_IMAGE=cr.jaegertracing.io/jaegertracing/jaeger:2.20.0
