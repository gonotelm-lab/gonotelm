# ==============================================================================
# gonotelm 本地启动的最小变量集合 / minimum variables to boot gonotelm locally
# ------------------------------------------------------------------------------
# 把下面的 key 填进 .env；为空时 make dev-up 或对应进程会直接启动失败。
# Fill these in .env; empty values make `make dev-up` or the matching process fail to start.
# 完整变量清单和说明见 .env.example / full list and docs: .env.example
# ==============================================================================

# PostgreSQL / ClickHouse / Kafka：密码要与本地中间件一致
# PostgreSQL / ClickHouse / Kafka passwords, must match the local middleware
GONOTELM_DB_PASSWORD=
GONOTELM_OLAP_DB_PASSWORD=
GONOTELM_KAFKA_PASSWORD=

# MinIO：gonotelm 私有桶和 gonotelm-public 公开桶的凭据，由 migration/storage/minio.sh 创建
# MinIO credentials for the private and public-read buckets, provisioned by migration/storage/minio.sh
GONOTELM_MINIO_ACCESS_KEY=
GONOTELM_MINIO_SECRET_KEY=
GONOTELM_PUBLIC_MINIO_ACCESS_KEY=
GONOTELM_PUBLIC_MINIO_SECRET_KEY=

# notelm / worker：启动校验要求非空；生成 artifact 时必须是已有 flow namespace 的 api key
# notelm / worker: must be non-empty at startup; a real namespace api key is needed to generate artifacts
GONOTELM_FLOW_API_KEY=

# notelm / worker / sourcejob：启动校验要求非空；sourcejob 和 worker 的生成任务需要有效 key
# notelm / worker / sourcejob: must be non-empty at startup; sourcejob and worker generation need a valid key
GONOTELM_DEEPSEEK_API_KEY=

# 聊天和 embedding 默认走 qwen，按需填写
# Chat and embeddings default to qwen; fill when needed
# GONOTELM_QWEN_API_KEY=
