        tl.to(st, { v: 12800, duration: 1.8, ease: "power3.out", onUpdate: () => { counterEl.textContent = Math.round(st.v).toLocaleString(); } }, 0.4);
        tl.fromTo(counterEl, { scale: 0.5 }, { scale: 1, duration: 1.8, ease: "power3.out" }, 0.4);
        tl.fromTo("#shot-02-label", { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, 0.9);
